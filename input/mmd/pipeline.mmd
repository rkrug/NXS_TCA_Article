---
config:
  theme: neutral
  layout: elk
  elk:
    nodePlacementStrategy: BRANDES_KOEPF
---

%% NXS TCS Article — end-to-end targets pipeline (flowchart).
%% Classic Mermaid syntax (no elk / no v11 @{shape}) so it renders both
%% standalone and embedded in the index report via Quarto's mermaid.

flowchart TD

  config["Configuration<br/><tt>input/config.yaml</tt>"]

  %% ===================================================================
  subgraph corpus_asm["Corpus assembly (Zotero → OpenAlex)"]
    direction TB

    defs[/"TCA/Nexus definitions<br/><tt>input/key papers/TCA and Nexus Definitions.csv</tt>"/]
    ztca(["Zotero TCA group<br/>(public, id 4589462)"])
    znxs(["Zotero NXS group<br/>(private, keyring)"])
    oa(["OpenAlex API"])
    snap[("OpenAlex snapshot<br/><tt>input/snapshot/</tt> · RELEASE 2026-01-15")]

    prep["<tt>prepare_key_definitions()</tt>"]
    dl["<tt>download_zotero_assessment()</tt> · nxs & tca"]
    ids["<tt>get_ids_from_dois()</tt> · nxs & tca"]
    corp["<tt>get_corpus_from_snapshot()</tt> · nxs & tca<br/>(+ Zotero fallback)"]

    key_db[("<tt>key_works</tt><br/>keypaper/key_works.parquet")]
    zdb[("zotero/assessment=*/chapter=*")]
    iddb[("ids/assessment=*")]
    corpus_db[("<tt>corpus</tt><br/>corpus/assessment=*/chapter=*")]

    defs --> prep --> key_db
    ztca --> dl
    znxs --> dl --> zdb
    zdb --> ids
    oa <--> ids
    ids --> iddb
    iddb --> corp
    snap --> corp
    zdb --> corp
    corp --> corpus_db
  end

  %% ===================================================================
  subgraph emb_stage["Embeddings (SPECTER2 via RunPod TEI)"]
    direction TB

    tei(["RunPod TEI<br/>(SPECTER2)"])
    embed["<tt>embed_works()</tt><br/>per assessment × variant × chapter"]
    emb_corpus[("embeddings/…/source=corpus/<br/>variant=*/assessment=*/chapter=*")]
    emb_kp[("embeddings/…/source=keypaper/variant=*")]
    r2sync["<tt>sync_*_embeddings_to_r2()</tt><br/>corpus excludes 'No Chapter'"]
    r2[("Cloudflare R2<br/>s3://nxs-tca-article/embeddings/")]

    corpus_db --> embed
    key_db --> embed
    tei <--> embed
    embed --> emb_corpus
    embed --> emb_kp
    emb_corpus --> r2sync
    emb_kp --> r2sync
    r2sync --> r2
  end

  %% ===================================================================
  subgraph score_stage["Keypaper similarity"]
    direction TB

    score["<tt>score_keypapers()</tt><br/>per variant"]
    score_comb["<tt>score_keypapers_combined()</tt><br/>title_abstract + title fallback"]
    scores_db[("scores/config=*/variant=*")]
    scores_comb_db[("scores_combined[_ta_ref]/<br/>config=*/assessment=*/chapter=*")]

    emb_corpus --> score --> scores_db
    emb_kp --> score
    emb_corpus --> score_comb --> scores_comb_db
    emb_kp --> score_comb
  end

  %% ===================================================================
  subgraph topic_stage["Topic modelling (BERTopic, RunPod GPU)"]
    direction TB

    pod(["RunPod BERTopic pod<br/>(cuml UMAP + HDBSCAN)"])
    bertopic["<tt>run_bertopic_runpod()</tt><br/>pod reads embeddings from R2"]
    topics_db[("topics/config=*/bertopic=*/variant=*")]

    r2 --> pod
    pod <--> bertopic
    bertopic --> topics_db
  end

  %% ===================================================================
  subgraph report_stage["Visualisation + reports (output/reports/)"]
    direction TB

    viz["viz_* / tbl_* targets<br/>(figures, tables, widgets)"]
    r_emb["Embedding Report<br/>(QC)"]
    r_ana["Chapter Analysis Report<br/>(chapter ↔ keypaper)"]
    r_top["Topic Modelling Report"]
    r_idx["Index — NXS TCS Article Report<br/>(intro + links + diagrams)"]

    scores_db --> viz
    scores_comb_db --> viz
    topics_db --> viz
    corpus_db --> viz
    key_db --> viz
    viz --> r_emb
    viz --> r_ana
    viz --> r_top
    r_emb --> r_idx
    r_ana --> r_idx
    r_top --> r_idx
  end

  config --> corpus_asm
  config --> emb_stage
  config --> topic_stage

  %% ===================================================================
  classDef input fill:#dbeafe,stroke:#2563eb,color:#1e3a8a;
  classDef config fill:#ecfccb,stroke:#65a30d,color:#14532d;
  classDef db fill:#fff3b0,stroke:#b45309,color:#111827;
  classDef proc fill:#bbf7d0,stroke:#16a34a,color:#14532d;
  classDef svc fill:#e0f2fe,stroke:#0284c7,color:#0f172a;

  class config config;
  class defs input;
  class ztca,znxs,oa,snap,tei,r2,pod svc;
  class key_db,zdb,iddb,corpus_db,emb_corpus,emb_kp,scores_db,scores_comb_db,topics_db db;
  class prep,dl,dl,ids,ids,corp,corp,embed,r2sync,score,score_comb,bertopic,viz,r_emb,r_ana,r_top,r_idx proc;
