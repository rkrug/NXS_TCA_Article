
sequenceDiagram
  autonumber

  actor       Orch as "Orchestrator (tar_make)"
  participant XL   as "Definitions .xlsx (4 sheets)"
  participant ZO   as "Zotero API"
  participant OA   as "OpenAlex API"
  participant SS   as "OpenAlex snapshot (local)"
  participant TEI  as "RunPod TEI (SPECTER2)"

  rect rgb(245,250,255)
    note over Orch,SS: Stage 1 - Corpus assembly (per assessment: tca, nxs)
    Orch ->> ZO:  download_zotero_assessment() (TCA public, NXS private)
    ZO  -->> Orch: items + tags -> zotero/assessment=*/chapter=*
    Orch ->> OA:  get_ids_from_dois() - resolve DOIs to OpenAlex ids
    OA  -->> Orch: id list -> ids/assessment=*
    Orch ->> SS:  get_corpus_from_snapshot(ids)
    SS  -->> Orch: full records (+ Zotero fallback) -> corpus_chapter/assessment=*/chapter=*
  end

  rect rgb(250,248,235)
    note over Orch,XL: Stage 2 - Keypapers + citations (from the definitions)
    Orch ->> XL: prepare_key_definitions() - read 4 sheets
    XL  -->> Orch: unified keypapers (citations stripped) -> keypaper/keyset=*
    Orch ->> Orch: extract_definition_citations() - regex (author, year)
    Orch ->> Orch: resolve_citations() - strict + loose, matching assessment
    note over Orch: unmatched kept for verification -> citations/resolved
    Orch ->> Orch: build_cited_corpus() - cited works (subset of corpus_chapter) -> corpus/
  end

  rect rgb(255,250,235)
    note over Orch,TEI: Stage 3 - Embedding (3 sources)
    Orch ->> TEI: POST /embed - corpus_chapter (x variant x chapter) + keypapers (x keyset)
    TEI -->> Orch: 768-D SPECTER2 vectors -> source=corpus_chapter, source=keypaper
    Orch ->> Orch: derive_source_embeddings() - filter corpus_chapter -> source=corpus (no re-embed)
  end

  rect rgb(255,245,245)
    note over Orch: Stage 4 - Keypaper scoring (chapter <-> keypaper, local)
    Orch ->> Orch: score_keypapers() - cosine corpus_chapter vs keypapers (per variant)
    Orch ->> Orch: score_keypapers_combined() - per assessment/chapter (title_abstract + title fallback)
  end

  rect rgb(240,255,245)
    note over Orch: Stage 5 - Keyset linkage (keypaper <-> keypaper)
    Orch ->> Orch: Stage 1 - definition-embedding cosine (build_link_stage1_data)
    Orch ->> Orch: Stage 2 - cited-literature overlap / Jaccard (build_link_stage2_data)
    Orch ->> Orch: Stage 3 - cited-literature embedding mean pairwise (build_link_stage3_data)
    note over Orch: 3 Sankeys + keyset x keyset matrices (TCA Action -> Nexus Response Option)
  end

  rect rgb(245,245,255)
    note over Orch: Stage 6 - Visualisation + reports
    Orch ->> Orch: viz_* / tbl_* targets
    Orch ->> Orch: render Embedding + Chapter Analysis reports, then index -> output/reports/
  end
