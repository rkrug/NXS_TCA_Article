# Config for the external/runpod submodule's create_pods.sh — the
# BAAI/bge-large-en-v1.5 TEI embedding pod (docker/tei-runpod-bge-large-en-v1.5/).
# Values here are shell variable assignments (sourced directly), not YAML.
#
# Usage (from this repo's root):
#   export RUNPOD_API_KEY=...
#   external/runpod/scripts/runpod/create_pods.sh -n 1 \
#     -c "$(pwd)/input/pods.conf.tei-bge-large-en-v1.5"
#
# Only ONE embedding pod is ever needed (R/embed_works.R talks to a single
# host), so -n 1. Paste the printed `host:` line into
# input/config.yaml's embeddings.configs.bge_large_runpod.host.

# Self-contained image: BAAI/bge-large-en-v1.5 (1024-dim, 512-token, cls
# pooling) baked in at build time. NOT yet published to GHCR — build + push it
# first from the submodule (its version lineage starts at v0.1.0):
#   REGISTRY=ghcr.io/rkrug make docker-tei-bge-large VERSION=v0.1.0
IMAGE="ghcr.io/rkrug/tei-runpod-bge-large-en-v1.5:v0.1.0"

# GPU type id exactly as RunPod expects it. L40S = SECURE-cloud, ECC, matches
# this project's other pods. The bge README suggests RTX 4090 for best
# throughput/$ (COMMUNITY cloud, cheaper but less guaranteed availability) —
# switch to GPU_TYPE_ID="NVIDIA GeForce RTX 4090" + CLOUD_TYPE="COMMUNITY" if
# you prefer that. Both use the image's default TEI_TAG=89-1.5 (Ada/Ampere-8.9).
GPU_TYPE_ID="NVIDIA L40S"
GPU_COUNT=1

# HTTP service exposed through RunPod's proxy at
# https://<pod-id>-8080.proxy.runpod.net — matches config.yaml's
# bge_large_runpod (scheme: https, port: 443 -> maps to this proxy).
POD_KIND="http"
PORT=8080
HEALTH_PATH="/health"

# Disk sizing (GB). Model (~1.3 GB fp16) is baked into the image; volume is
# headroom only (persistent TEI logs land here).
CONTAINER_DISK_GB=20
VOLUME_GB=5
VOLUME_MOUNT_PATH="/workspace"

# RunPod cloud tier: SECURE (RunPod-operated DCs) or COMMUNITY (cheaper, less
# guaranteed availability). HTTP-proxied ports don't need SUPPORT_PUBLIC_IP.
CLOUD_TYPE="SECURE"

# Name prefix; pods are named "<prefix>-<timestamp>-01", ...
POD_NAME_PREFIX="tei-bge-large-en-v15"

# Idle watchdog (docker/tei-runpod-bge-large-en-v1.5/tei_idle_watchdog.sh):
# auto-stops the pod after IDLE_MIN minutes with no new /embed requests.
IDLE_MIN=5
POLL_SEC=30

# Value for the pod's own RUNPOD_API_KEY env var (used by the idle watchdog's
# self-stop REST call). Store the raw key as a RunPod Secret named
# runpod_api_key so it never appears in the API request body.
POD_ENV_RUNPOD_API_KEY='{{ RUNPOD_SECRET_runpod_api_key }}'

# Extra env vars merged into the pod, as "KEY=VALUE" strings. All have sane
# defaults baked into the image — uncomment only to override without rebuilding.
EXTRA_ENV=(
  # "TEI_MAX_BATCH_TOKENS=32768"
  # "TEI_MAX_CONCURRENT=512"
  # "TEI_MAX_CLIENT_BATCH=128"
)

# How long (seconds) to poll the new pod's /health before giving up.
HEALTH_TIMEOUT_SEC=300
HEALTH_POLL_INTERVAL_SEC=10

# Delay (seconds) between successive pod-creation calls. Irrelevant at -n 1.
CREATE_DELAY_SEC=10
