# Config for scripts/runpod/create_pods.sh — the SPECTER2/TEI embedding pod
# (docker/tei-runpod/). Copy to pods.conf and edit; pods.conf is gitignored
# so local overrides never get committed. Values here are shell variable
# assignments (sourced directly), not YAML.
#
# Usage:
#   cp scripts/runpod/pods.conf.embedding scripts/runpod/pods.conf
#   export RUNPOD_API_KEY=...
#   scripts/runpod/create_pods.sh -n 1 -c scripts/runpod/pods.conf
#
# Only ONE embedding pod is ever needed — R/embed_works.R's TEI backend
# (build_tei_backend()) talks to a single host, not a pool — so -n 1. Prints
# a `host:` line to paste into input/config.yaml's active `embeddings.configs.*`
# entry (currently SPECTER2_runpod).
#
# RUNPOD_API_KEY is NOT set here — export it in your shell before running the
# script. It authenticates the pod-creation API call itself (this always needs
# the raw key — RunPod Secrets are substituted inside a running pod, not in
# requests to create one).

# Self-contained image: the merged SPECTER2 (proximity adapter) model is
# baked in at build time (see docker/tei-runpod/README.md) — no volume
# mount, no first-boot download. Bump the tag after rebuilding/pushing.
IMAGE="ghcr.io/rkrug/tei-specter2:proximity-v0.1.1"

# GPU type id exactly as RunPod expects it. List available ids with:
#   curl -s https://rest.runpod.io/v1/gpuTypes \
#     -H "Authorization: Bearer $RUNPOD_API_KEY" | jq -r '.[].id'
# L40S matches the tuning baked into config.yaml's SPECTER2_runpod entry
# (concurrency: 14 "saturates the L40S via dynamic batching"). A100 80GB is
# a safe, more available alternative — TEI_TAG in the image was picked for
# Ada/Hopper (89-1.5); rebuild with an 86-1.5 base if you switch to Ampere.
GPU_TYPE_ID="NVIDIA L40S"
GPU_COUNT=1

# HTTP service exposed through RunPod's proxy at
# https://<pod-id>-8080.proxy.runpod.net — matches embeddings.configs.*.port
# in config.yaml (scheme: https, port: 443 -> maps to this proxy).
POD_KIND="http"
PORT=8080
HEALTH_PATH="/health"

# Disk sizing (GB). Model is baked into the image; volume is headroom only
# (persistent TEI logs land here — see docker/tei-runpod/README.md).
CONTAINER_DISK_GB=15
VOLUME_GB=5
VOLUME_MOUNT_PATH="/workspace"

# RunPod cloud tier: SECURE (RunPod-operated DCs) or COMMUNITY (cheaper, less
# guaranteed availability). HTTP-proxied ports don't need SUPPORT_PUBLIC_IP
# (that only matters for TCP-exposed ports like the bertopic pod's SSH).
CLOUD_TYPE="SECURE"

# Name prefix; pods are named "<prefix>-<timestamp>-01", ...
POD_NAME_PREFIX="tei-specter2"

# Idle watchdog settings (docker/tei-runpod/tei_idle_watchdog.sh), passed
# into the pod's environment. Auto-stops the pod after IDLE_MIN minutes of
# no new /embed requests.
IDLE_MIN=5
POLL_SEC=30

# Value for the created pod's own RUNPOD_API_KEY env var (used internally by
# the idle watchdog's `runpodctl stop pod` call). Leave unset to fall back to
# the raw local RUNPOD_API_KEY (simplest, but the raw key ends up in the API
# request body and hosts.generated.*). Set to a RunPod Secret reference
# instead so the raw key never leaves RunPod's secret store — RunPod
# substitutes the real value only when the pod boots.
POD_ENV_RUNPOD_API_KEY='{{ RUNPOD_SECRET_runpod_api_key }}'

# Extra env vars merged into every created pod, as "KEY=VALUE" strings.
# All have sane defaults baked into the image (see docker/tei-runpod/README.md
# "Runtime tuning") — uncomment only to override without rebuilding.
EXTRA_ENV=(
  # "TEI_MAX_BATCH_TOKENS=131072"
  # "TEI_MAX_CONCURRENT=2048"
  # "TEI_MAX_CLIENT_BATCH=512"
)

# How long (seconds) to poll the new pod's /health before giving up.
HEALTH_TIMEOUT_SEC=300
HEALTH_POLL_INTERVAL_SEC=10

# Delay (seconds) between successive pod-creation calls when creating several
# at once. Irrelevant at -n 1 but harmless to leave set.
CREATE_DELAY_SEC=10
